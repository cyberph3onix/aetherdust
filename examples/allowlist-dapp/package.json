{
  "name": "@aetherdust/allowlist-dapp",
  "version": "0.1.0",
  "private": true,
  "description": "Private Allowlist Access \u2014 prove membership without revealing identity, with the DUST fee sponsored by AetherDust.",
  "type": "module",
  "scripts": {
    "compile": "compact compile contract/src/allowlist.compact contract/managed/allowlist && pnpm sync-assets",
    "sync-assets": "rm -rf public/allowlist && mkdir -p public/allowlist && cp -r contract/managed/allowlist/compiler contract/managed/allowlist/keys contract/managed/allowlist/zkir public/allowlist/",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project unit examples/allowlist-dapp/contract/allowlist.test.ts",
    "deploy-contract": "tsx --conditions=development deploy.ts"
  },
  "dependencies": {
    "@aetherdust/client": "workspace:*",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aetherdust/config": "workspace:*",
    "@aetherdust/midnight": "workspace:*",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
