{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true, "esModuleInterop": true, "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "contract/**/*.ts", "vite.config.ts"]
}
