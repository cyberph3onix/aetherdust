# syntax=docker/dockerfile:1.7
# The operator dashboard: a static bundle served by nginx, which also proxies the API so the dashboard is
# same-origin (no CORS setup, and the default API base URL — the page's own origin — just works).
FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@12.3.4 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile --filter @aetherdust/dashboard...
RUN pnpm --filter @aetherdust/dashboard build

FROM nginx:1.27-alpine
COPY --from=build /app/apps/dashboard/dist /usr/share/nginx/html
COPY deploy/dashboard.nginx.conf /etc/nginx/templates/default.conf.template
ENV AETHERDUST_API_UPSTREAM=http://api:8080
EXPOSE 80
